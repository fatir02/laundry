<%- include('../partials/header', { title: 'Manajemen Pesanan' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

  <!-- Top Action & Title Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-slate-200">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Admin <%= outlet.name %></h1>
        <span class="px-2.5 py-1 text-xs font-bold bg-blue-100 text-blue-800 rounded-lg">POS & Kasir</span>
      </div>
      <p class="text-slate-500 text-xs sm:text-sm mt-0.5">Kelola pesanan cucian, catat berat & jumlah baju, dan kirim notifikasi WA ke pelanggan.</p>
    </div>

    <!-- Top Buttons -->
    <div class="flex items-center gap-3">
      <a 
        href="/admin/reports" 
        class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm flex items-center gap-2 transition-all"
        title="Lihat Rekap Penjualan & Keuangan Bulanan"
      >
        <i class="fa-solid fa-chart-line"></i>
        <span>Rekap Transaksi Bulanan</span>
      </a>

      <!-- Create Order Button -->
      <button 
        onclick="openNewOrderModal()" 
        class="bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-md shadow-blue-500/25 flex items-center gap-2 transition-all hover:scale-[1.02]"
      >
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Pesanan Baru</span>
      </button>
    </div>
  </div>

  <!-- Summary Stats Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Total Orders -->
    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0">
        <i class="fa-solid fa-layer-group"></i>
      </div>
      <div>
        <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Total Pesanan</p>
        <p class="text-xl sm:text-2xl font-black text-slate-800"><%= stats.total %></p>
      </div>
    </div>

    <!-- Processing -->
    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0">
        <i class="fa-solid fa-arrows-rotate fa-spin text-lg"></i>
      </div>
      <div>
        <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Sedang Dicuci</p>
        <p class="text-xl sm:text-2xl font-black text-amber-600"><%= stats.processing %></p>
      </div>
    </div>

    <!-- Ready for Pickup/Delivery -->
    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
        <i class="fa-solid fa-bag-shopping text-lg"></i>
      </div>
      <div>
        <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Siap Diambil</p>
        <p class="text-xl sm:text-2xl font-black text-emerald-600"><%= stats.ready %></p>
      </div>
    </div>

    <!-- Unpaid -->
    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl shrink-0">
        <i class="fa-solid fa-hand-holding-dollar text-lg"></i>
      </div>
      <div>
        <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Belum Lunas (Piutang)</p>
        <p class="text-base sm:text-lg font-black text-rose-600"><%= formatRupiah(stats.unpaidTotal) %></p>
      </div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm">
    <form action="/admin/orders" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
      
      <!-- Search Input -->
      <div class="lg:col-span-5 relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
        <input 
          type="text" 
          name="search" 
          value="<%= filters.search %>"
          placeholder="Cari invoice, nama pelanggan, no. HP..." 
          class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
        >
      </div>

      <!-- Filter Laundry Status -->
      <div class="lg:col-span-3">
        <select 
          name="laundry_status" 
          onchange="this.form.submit()"
          class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
        >
          <option value="all" <%= filters.laundry_status === 'all' ? 'selected' : '' %>>Semua Status Cucian</option>
          <option value="Sedang Diproses" <%= filters.laundry_status === 'Sedang Diproses' ? 'selected' : '' %>>Sedang Diproses</option>
          <option value="Siap Diambil" <%= filters.laundry_status === 'Siap Diambil' ? 'selected' : '' %>>Siap Diambil</option>
          <option value="Siap Diantar" <%= filters.laundry_status === 'Siap Diantar' ? 'selected' : '' %>>Siap Diantar</option>
          <option value="Selesai" <%= filters.laundry_status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
        </select>
      </div>

      <!-- Filter Payment Status -->
      <div class="lg:col-span-3">
        <select 
          name="payment_status" 
          onchange="this.form.submit()"
          class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
        >
          <option value="all" <%= filters.payment_status === 'all' ? 'selected' : '' %>>Semua Status Bayar</option>
          <option value="Belum Lunas" <%= filters.payment_status === 'Belum Lunas' ? 'selected' : '' %>>Belum Lunas (Bayar Nanti)</option>
          <option value="Lunas" <%= filters.payment_status === 'Lunas' ? 'selected' : '' %>>Lunas</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="lg:col-span-1 flex gap-2">
        <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white py-2.5 rounded-xl text-sm font-semibold transition-colors flex items-center justify-center" title="Terapkan Filter">
          <i class="fa-solid fa-filter"></i>
        </button>
        <% if (filters.search || filters.laundry_status !== 'all' || filters.payment_status !== 'all') { %>
          <a href="/admin/orders" class="p-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm transition-colors flex items-center justify-center" title="Reset Filter">
            <i class="fa-solid fa-xmark"></i>
          </a>
        <% } %>
      </div>

    </form>
  </div>

  <!-- Orders List -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-2 font-bold text-slate-800">
        <i class="fa-solid fa-list-check text-blue-600"></i>
        <span>Daftar Transaksi Pesanan</span>
        <span class="text-xs bg-slate-100 text-slate-600 font-semibold px-2 py-0.5 rounded-full"><%= orders.length %> pesanan</span>
      </div>
    </div>

    <% if (orders.length === 0) { %>
      <div class="py-16 text-center text-slate-400">
        <i class="fa-solid fa-folder-open text-4xl mb-3"></i>
        <p class="text-base font-semibold text-slate-600">Tidak ada data pesanan yang sesuai</p>
        <p class="text-xs mt-1">Coba ubah kata kunci pencarian atau filter status.</p>
      </div>
    <% } else { %>
      
      <!-- Desktop Table View -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50/80 text-slate-500 font-bold uppercase text-[11px] tracking-wider border-b border-slate-200/70">
            <tr>
              <th class="px-5 py-3.5">Invoice & Waktu</th>
              <th class="px-4 py-3.5">Pelanggan</th>
              <th class="px-4 py-3.5">Layanan, Berat & Baju</th>
              <th class="px-4 py-3.5">Total Tagihan</th>
              <th class="px-4 py-3.5 text-center">Status Cucian</th>
              <th class="px-4 py-3.5 text-center">Status Bayar</th>
              <th class="px-5 py-3.5 text-right">Aksi & WhatsApp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-normal">
            <% orders.forEach(order => { %>
              <tr class="hover:bg-slate-50/60 transition-colors">
                
                <!-- Invoice & Date -->
                <td class="px-5 py-4">
                  <a href="/track/<%= order.invoice_code %>" target="_blank" class="font-mono font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1.5 group">
                    <span><%= order.invoice_code %></span>
                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-0 group-hover:opacity-100 transition-opacity"></i>
                  </a>
                  <span class="text-xs text-slate-400 block mt-0.5"><%= formatDateIndo(order.created_at) %></span>
                </td>

                <!-- Customer Details -->
                <td class="px-4 py-4">
                  <span class="font-bold text-slate-800 block"><%= order.customer_name %></span>
                  <span class="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                    <i class="fa-solid fa-phone text-[10px]"></i> <%= order.customer_phone %>
                  </span>
                  <span class="text-[11px] text-slate-400 truncate max-w-[180px] block" title="<%= order.customer_address %>">
                    <%= order.customer_address %>
                  </span>
                </td>

                <!-- Service, Weight & Piece Count -->
                <td class="px-4 py-4">
                  <span class="font-semibold text-slate-700 block"><%= order.service_name %></span>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-xs bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-bold"><%= order.weight %> kg</span>
                    <% if (order.piece_count > 0) { %>
                      <span class="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-semibold"><%= order.piece_count %> potong baju</span>
                    <% } %>
                    <span class="text-xs text-slate-400">
                      <i class="fa-solid <%= order.pickup_method === 'Diantar Kurir' ? 'fa-motorcycle' : 'fa-store' %> text-[10px]"></i> <%= order.pickup_method %>
                    </span>
                  </div>
                </td>

                <!-- Total Price -->
                <td class="px-4 py-4 font-bold text-slate-900">
                  <%= formatRupiah(order.total_price) %>
                </td>

                <!-- Quick Laundry Status Progression -->
                <td class="px-4 py-4 text-center">
                  <div class="flex flex-col items-center gap-1.5">
                    <span class="px-3 py-1 rounded-full text-xs font-bold inline-flex items-center gap-1.5 shadow-sm
                      <% if (order.laundry_status === 'Sedang Diproses') { %>
                        bg-amber-100 text-amber-800 border border-amber-200
                      <% } else if (order.laundry_status === 'Siap Diambil' || order.laundry_status === 'Siap Diantar') { %>
                        bg-emerald-100 text-emerald-800 border border-emerald-200
                      <% } else { %>
                        bg-slate-100 text-slate-700 border border-slate-200
                      <% } %>
                    ">
                      <% if (order.laundry_status === 'Sedang Diproses') { %>
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                      <% } else if (order.laundry_status === 'Siap Diambil' || order.laundry_status === 'Siap Diantar') { %>
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      <% } else { %>
                        <i class="fa-solid fa-check text-[10px]"></i>
                      <% } %>
                      <%= order.laundry_status %>
                    </span>

                    <form action="/admin/orders/<%= order.id %>/next-status" method="POST" class="inline">
                      <button 
                        type="submit" 
                        class="text-[11px] font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-2 py-0.5 rounded transition-colors"
                        title="Klik untuk ubah ke status berikutnya"
                      >
                        <% if (order.laundry_status === 'Sedang Diproses') { %>
                          ➔ Set <%= order.pickup_method === 'Diantar Kurir' ? 'Siap Diantar' : 'Siap Diambil' %>
                        <% } else if (order.laundry_status === 'Siap Diambil' || order.laundry_status === 'Siap Diantar') { %>
                          ➔ Set Selesai
                        <% } else { %>
                          ➔ Ulangi Proses
                        <% } %>
                      </button>
                    </form>
                  </div>
                </td>

                <!-- Quick Payment Toggle -->
                <td class="px-4 py-4 text-center">
                  <form action="/admin/orders/<%= order.id %>/toggle-payment" method="POST">
                    <button 
                      type="submit" 
                      class="px-3 py-1 rounded-full text-xs font-bold transition-all inline-flex items-center gap-1.5 shadow-sm
                        <%= order.payment_status === 'Lunas' ? 'bg-emerald-600 hover:bg-emerald-700 text-white' : 'bg-rose-500 hover:bg-rose-600 text-white' %>"
                      title="Klik untuk ubah status pembayaran"
                    >
                      <i class="fa-solid <%= order.payment_status === 'Lunas' ? 'fa-check-circle' : 'fa-clock' %> text-[11px]"></i>
                      <span><%= order.payment_status %></span>
                    </button>
                  </form>
                </td>

                <!-- WhatsApp & Actions -->
                <td class="px-5 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <% 
                      let cleanPhone = (order.customer_phone || '').replace(/[^0-9]/g, '');
                      if (cleanPhone.startsWith('0')) cleanPhone = '62' + cleanPhone.slice(1);
                      const trackLink = `${hostUrl}/track/${order.invoice_code}`;
                      
                      // Pre-formatted friendly notification message
                      const waReadyMsg = encodeURIComponent(
`*${outlet.name} - NOTIFIKASI CUCIAN SIAP*
-----------------------------------------
Halo Kak *${order.customer_name}*, cucian Anda di *${outlet.name}* sudah selesai, wangi, dan rapi! ✨

📋 *Detail Nota:*
• No. Invoice: *${order.invoice_code}*
• Paket: ${order.service_name} (${order.weight} kg ${order.piece_count > 0 ? '/ ' + order.piece_count + ' pcs' : ''})
• Total Tagihan: *${formatRupiah(order.total_price)}*
• Status Bayar: *${order.payment_status}*
• Status Cucian: *${order.laundry_status}*

${order.pickup_method === 'Diantar Kurir' ? '🛵 Cucian akan segera dikirim kurir ke alamat Anda.' : '🏠 Silakan diambil di outlet kami:\n' + outlet.address}

🔍 *Cek Nota Digital:*
${trackLink}

Terima kasih telah mempercayakan pakaian Anda di *${outlet.name}*!`
                      );
                    %>

                    <!-- Send WA Notification Button -->
                    <a 
                      href="https://wa.me/<%= cleanPhone %>?text=<%= waReadyMsg %>" 
                      target="_blank"
                      class="px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition-all inline-flex items-center gap-1.5 shadow-sm shadow-emerald-600/20"
                      title="Kirim Notifikasi WA ke Pelanggan"
                    >
                      <i class="fa-brands fa-whatsapp text-sm"></i>
                      <span>Kirim WA</span>
                    </a>

                    <!-- Delete Button -->
                    <form action="/admin/orders/<%= order.id %>/delete" method="POST" onsubmit="return confirm('Hapus pesanan <%= order.invoice_code %>?')" class="inline">
                      <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors" title="Hapus">
                        <i class="fa-regular fa-trash-can text-sm"></i>
                      </button>
                    </form>
                  </div>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards View -->
      <div class="block md:hidden divide-y divide-slate-100">
        <% orders.forEach(order => { %>
          <div class="p-4 space-y-3">
            <div class="flex items-center justify-between">
              <a href="/track/<%= order.invoice_code %>" class="font-mono font-bold text-blue-600 text-sm">
                <%= order.invoice_code %>
              </a>
              <form action="/admin/orders/<%= order.id %>/toggle-payment" method="POST">
                <button type="submit" class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= order.payment_status === 'Lunas' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                  <%= order.payment_status %>
                </button>
              </form>
            </div>

            <div>
              <div class="flex justify-between items-baseline">
                <span class="font-bold text-slate-900 text-base"><%= order.customer_name %></span>
                <span class="font-extrabold text-blue-700 text-base"><%= formatRupiah(order.total_price) %></span>
              </div>
              <p class="text-xs text-slate-500 mt-0.5">
                <%= order.customer_phone %> • <%= order.service_name %> (<%= order.weight %> kg<%= order.piece_count > 0 ? ', ' + order.piece_count + ' pcs' : '' %>)
              </p>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= order.laundry_status === 'Sedang Diproses' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>">
                <%= order.laundry_status %>
              </span>
              <form action="/admin/orders/<%= order.id %>/next-status" method="POST">
                <button type="submit" class="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-lg">
                  Next Status ➔
                </button>
              </form>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-slate-100">
              <span class="text-[11px] text-slate-400"><%= formatDateShort(order.created_at) %></span>
              <% 
                let cleanPhoneMob = (order.customer_phone || '').replace(/[^0-9]/g, '');
                if (cleanPhoneMob.startsWith('0')) cleanPhoneMob = '62' + cleanPhoneMob.slice(1);
                const trackLinkMob = `${hostUrl}/track/${order.invoice_code}`;
                const waTextMob = encodeURIComponent(`Halo Kak *${order.customer_name}*, cucian Anda di *${outlet.name}* (${order.invoice_code}) status: *${order.laundry_status}*. Total: ${formatRupiah(order.total_price)}. Lacak di: ${trackLinkMob}`);
              %>
              <div class="flex items-center gap-2">
                <a href="https://wa.me/<%= cleanPhoneMob %>?text=<%= waTextMob %>" target="_blank" class="px-3 py-1 bg-emerald-600 text-white rounded-lg text-xs font-bold flex items-center gap-1">
                  <i class="fa-brands fa-whatsapp"></i> WA
                </a>
                <a href="/track/<%= order.invoice_code %>" class="px-3 py-1 bg-slate-100 text-slate-700 rounded-lg text-xs font-bold">
                  Detail
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

    <% } %>

  </div>

</div>

<!-- MODAL: Tambah Pesanan Baru -->
<div id="newOrderModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4 overflow-y-auto">
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-100 my-8 transition-all">
    
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
          <i class="fa-solid fa-cart-plus"></i>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900">Buat Nota Cucian Baru</h3>
      </div>
      <button onclick="closeNewOrderModal()" class="text-slate-400 hover:text-slate-600 p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/orders" method="POST" id="newOrderForm" class="mt-5 space-y-4">
      
      <!-- Customer Type Selector: Tab -->
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Tipe Pelanggan</label>
        <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl">
          <button type="button" id="tabNewCustomer" onclick="selectCustomerTab('new')" class="py-2 text-xs font-bold rounded-lg transition-all bg-white text-blue-700 shadow-sm">
            + Pelanggan Baru
          </button>
          <button type="button" id="tabExistingCustomer" onclick="selectCustomerTab('existing')" class="py-2 text-xs font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900">
            Pelanggan Terdaftar
          </button>
        </div>
        <input type="hidden" name="customer_type" id="customer_type" value="new">
      </div>

      <!-- New Customer Fields -->
      <div id="newCustomerFields" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap Pelanggan *</label>
          <input type="text" name="customer_name" id="customer_name" placeholder="Misal: Bu Endang" required class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Nomor WhatsApp / HP *</label>
          <input type="tel" name="customer_phone" id="customer_phone" placeholder="Misal: 081227800060" required class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Alamat (Untuk Antar Kurir)</label>
          <textarea name="customer_address" id="customer_address" rows="2" placeholder="Desa Karangsentul, RT 02/01, Padamara..." class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white"></textarea>
        </div>
      </div>

      <!-- Existing Customer Dropdown -->
      <div id="existingCustomerFields" class="space-y-3 hidden">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Pilih Pelanggan Terdaftar</label>
          <select name="existing_customer_id" id="existing_customer_id" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
            <option value="">-- Pilih Pelanggan --</option>
            <% customers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %> (<%= c.phone %>)</option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Service Selection & Weight + Piece Count -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        <div class="sm:col-span-1">
          <label class="block text-xs font-bold text-slate-700 mb-1">Layanan *</label>
          <select name="service_id" id="service_id" required onchange="calculateTotal()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white font-medium">
            <% services.forEach(s => { %>
              <option value="<%= s.id %>" data-price="<%= s.price_per_unit %>" data-unit="<%= s.unit_type %>">
                <%= s.name %> (<%= formatRupiah(s.price_per_unit) %>)
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Berat (Kg) *</label>
          <input type="number" step="0.1" min="0.1" name="weight" id="weight" value="1.0" required oninput="calculateTotal()" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white font-bold">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Total Baju (Pcs)</label>
          <input type="number" min="0" name="piece_count" id="piece_count" placeholder="Misal: 12" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
        </div>
      </div>

      <!-- Pickup Method & Payment Status -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Metode Pengambilan</label>
          <select name="pickup_method" id="pickup_method" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
            <option value="Ambil Sendiri">Ambil Sendiri (di Outlet)</option>
            <option value="Diantar Kurir">Diantar Kurir</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Status Bayar (Bisa Belum)</label>
          <select name="payment_status" id="payment_status" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
            <option value="Belum Lunas">Belum Lunas (Bayar Saat Ambil)</option>
            <option value="Lunas">Lunas (Sudah Bayar)</option>
          </select>
        </div>
      </div>

      <!-- Notes -->
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Catatan Pakaian / Parfum (Opsional)</label>
        <input type="text" name="notes" placeholder="Contoh: Pisahkan pakaian luntur / pewangi lavender" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white">
      </div>

      <!-- Calculation Display Banner -->
      <div class="p-4 rounded-2xl bg-blue-50/80 border border-blue-200/80 flex items-center justify-between">
        <div>
          <span class="text-xs text-blue-700 font-bold uppercase tracking-wider block">Total Tagihan Otomatis</span>
          <span class="text-xs text-slate-500" id="calculation-desc">-</span>
        </div>
        <div class="text-right">
          <span class="text-xl sm:text-2xl font-black text-blue-700 font-mono" id="calculated-total">Rp 0</span>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeNewOrderModal()" class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
          Batal
        </button>
        <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white rounded-xl text-xs sm:text-sm font-bold shadow-md shadow-blue-500/30 transition-all flex items-center gap-2">
          <i class="fa-solid fa-check"></i>
          <span>Simpan & Buat Nota</span>
        </button>
      </div>

    </form>
  </div>
</div>

<%- include('../partials/footer') %>
