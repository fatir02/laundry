<%- include('../partials/header', { title: 'Rekap Transaksi & Laporan Penjualan' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

  <!-- Top Action & Title Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Rekap Transaksi & Penjualan</h1>
        <span class="px-2.5 py-1 text-xs font-bold bg-emerald-100 text-emerald-800 rounded-lg">Laporan Keuangan</span>
      </div>
      <p class="text-slate-500 text-xs sm:text-sm mt-0.5">
        Pembukuan transaksi otomatis untuk <strong><%= outlet.name %></strong> (tidak perlu rekap tulis manual).
      </p>
    </div>

    <!-- Export & Print Actions -->
    <div class="flex items-center gap-2.5">
      <a 
        href="/admin/reports/export-csv?month=<%= selectedMonth %>" 
        class="bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition-all flex items-center gap-2"
        title="Download file Excel (.csv)"
      >
        <i class="fa-solid fa-file-excel text-base"></i>
        <span>Download Excel</span>
      </a>

      <button 
        onclick="window.print()" 
        class="bg-slate-800 hover:bg-slate-900 active:bg-black text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition-all flex items-center gap-2"
        title="Cetak Laporan / Simpan PDF"
      >
        <i class="fa-solid fa-print"></i>
        <span>Cetak Laporan</span>
      </button>

      <a 
        href="/admin/orders" 
        class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all flex items-center gap-2"
      >
        <i class="fa-solid fa-arrow-left"></i>
        <span>Kelola Pesanan</span>
      </a>
    </div>
  </div>

  <!-- Month & Filter Selector Bar -->
  <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-sm no-print">
    <form action="/admin/reports" method="GET" class="flex flex-wrap items-center justify-between gap-4">
      
      <div class="flex flex-wrap items-center gap-3">
        <!-- Month Selector -->
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Pilih Periode Bulan</label>
          <div class="relative">
            <i class="fa-regular fa-calendar absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input 
              type="month" 
              name="month" 
              value="<%= selectedMonth %>" 
              onchange="this.form.submit()"
              class="pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
          </div>
        </div>

        <!-- Payment Filter -->
        <div>
          <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">Status Pembayaran</label>
          <select 
            name="payment_status" 
            onchange="this.form.submit()"
            class="px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="all" <%= paymentFilter === 'all' ? 'selected' : '' %>>Semua Transaksi</option>
            <option value="Lunas" <%= paymentFilter === 'Lunas' ? 'selected' : '' %>>Hanya yang Lunas</option>
            <option value="Belum Lunas" <%= paymentFilter === 'Belum Lunas' ? 'selected' : '' %>>Hanya Belum Lunas</option>
          </select>
        </div>
      </div>

      <div class="text-right">
        <span class="text-xs text-slate-400 font-medium">Periode Terpilih:</span>
        <p class="text-sm font-extrabold text-blue-700"><%= selectedMonth %></p>
      </div>

    </form>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <!-- Total Omset Lunas -->
    <div class="bg-gradient-to-br from-emerald-600 to-teal-700 text-white p-5 rounded-2xl shadow-sm">
      <div class="flex items-center justify-between opacity-85 text-xs font-bold uppercase tracking-wider mb-1">
        <span>Uang Masuk (Lunas)</span>
        <i class="fa-solid fa-circle-check text-base"></i>
      </div>
      <p class="text-2xl sm:text-3xl font-black tracking-tight"><%= formatRupiah(summary.totalRevenue) %></p>
      <p class="text-[11px] opacity-80 mt-1">Omset bersih yang sudah dibayar</p>
    </div>

    <!-- Total Belum Lunas / Piutang -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">
        <span>Belum Lunas (Piutang)</span>
        <i class="fa-solid fa-clock text-rose-500 text-base"></i>
      </div>
      <p class="text-2xl sm:text-3xl font-black text-rose-600 tracking-tight"><%= formatRupiah(summary.totalUnpaid) %></p>
      <p class="text-[11px] text-slate-400 mt-1">Tagihan pelanggan yang belum dibayar</p>
    </div>

    <!-- Total Berat & Pcs -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">
        <span>Total Volume Cucian</span>
        <i class="fa-solid fa-scale-balanced text-blue-600 text-base"></i>
      </div>
      <p class="text-2xl sm:text-3xl font-black text-slate-800 tracking-tight"><%= summary.totalWeight %> <span class="text-sm font-semibold text-slate-500">kg</span></p>
      <p class="text-[11px] text-slate-400 mt-1">Total <%= summary.totalPieces %> potong pakaian dihitung</p>
    </div>

    <!-- Total Transaksi -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
      <div class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">
        <span>Total Nota Transaksi</span>
        <i class="fa-solid fa-receipt text-indigo-600 text-base"></i>
      </div>
      <p class="text-2xl sm:text-3xl font-black text-slate-800 tracking-tight"><%= summary.totalOrders %> <span class="text-sm font-semibold text-slate-500">nota</span></p>
      <p class="text-[11px] text-slate-400 mt-1"><%= summary.completedOrders %> selesai, <%= summary.processingOrders %> diproses</p>
    </div>

  </div>

  <!-- Service Breakdown Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-5 space-y-3">
    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
      <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
        <i class="fa-solid fa-chart-pie text-blue-600"></i>
        <span>Rincian Pendapatan per Jenis Layanan</span>
      </h3>
      <span class="text-xs text-slate-400">Periode: <%= selectedMonth %></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
      <% Object.keys(serviceBreakdown).forEach(svcName => { 
          const svc = serviceBreakdown[svcName];
      %>
        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 space-y-1">
          <span class="text-xs font-bold text-slate-700 block truncate" title="<%= svcName %>"><%= svcName %></span>
          <div class="flex items-baseline justify-between pt-1">
            <span class="text-xs text-slate-500"><%= svc.count %> order (<%= svc.total_kg %> kg)</span>
            <span class="text-sm font-bold text-blue-700"><%= formatRupiah(svc.total_income) %></span>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Detailed Transaction Log Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <div class="font-bold text-slate-800 text-sm flex items-center gap-2">
        <i class="fa-solid fa-list-ol text-blue-600"></i>
        <span>Daftar Rincian Rekap Transaksi Bulan <%= selectedMonth %></span>
      </div>
      <span class="text-xs text-slate-500 font-semibold"><%= orders.length %> transaksi tercatat</span>
    </div>

    <% if (orders.length === 0) { %>
      <div class="py-12 text-center text-slate-400 text-sm">
        <i class="fa-regular fa-folder-open text-3xl mb-2"></i>
        <p>Belum ada transaksi yang tercatat pada bulan <%= selectedMonth %>.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[11px] tracking-wider border-b border-slate-200">
            <tr>
              <th class="px-4 py-3">No</th>
              <th class="px-4 py-3">Waktu & Invoice</th>
              <th class="px-4 py-3">Pelanggan</th>
              <th class="px-4 py-3">Layanan</th>
              <th class="px-4 py-3 text-center">Berat / Baju</th>
              <th class="px-4 py-3 text-right">Total Tagihan</th>
              <th class="px-4 py-3 text-center">Pembayaran</th>
              <th class="px-4 py-3 text-center">Status Cucian</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% orders.forEach((o, index) => { %>
              <tr class="hover:bg-slate-50/70 transition-colors">
                <td class="px-4 py-3 text-slate-400 font-mono"><%= index + 1 %></td>
                <td class="px-4 py-3">
                  <a href="/track/<%= o.invoice_code %>" target="_blank" class="font-mono font-bold text-blue-600 hover:underline">
                    <%= o.invoice_code %>
                  </a>
                  <span class="text-[11px] text-slate-400 block"><%= formatDateShort(o.created_at) %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="font-bold text-slate-800"><%= o.customer_name %></span>
                  <span class="text-[11px] text-slate-400 block"><%= o.customer_phone %></span>
                </td>
                <td class="px-4 py-3 text-slate-700"><%= o.service_name %></td>
                <td class="px-4 py-3 text-center">
                  <span class="font-bold text-slate-800"><%= o.weight %> kg</span>
                  <% if (o.piece_count > 0) { %>
                    <span class="text-[11px] text-slate-400 block">(<%= o.piece_count %> pcs)</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-right font-extrabold text-slate-900">
                  <%= formatRupiah(o.total_price) %>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold
                    <%= o.payment_status === 'Lunas' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                    <%= o.payment_status %>
                  </span>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold
                    <%= o.laundry_status === 'Selesai' ? 'bg-slate-100 text-slate-700' : (o.laundry_status === 'Sedang Diproses' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800') %>">
                    <%= o.laundry_status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot class="bg-slate-100/80 font-bold border-t border-slate-200 text-slate-900">
            <tr>
              <td colspan="4" class="px-4 py-3 text-right">TOTAL KESELURUHAN:</td>
              <td class="px-4 py-3 text-center"><%= summary.totalWeight %> kg (<%= summary.totalPieces %> pcs)</td>
              <td class="px-4 py-3 text-right text-base text-blue-700"><%= formatRupiah(summary.totalGross) %></td>
              <td colspan="2" class="px-4 py-3 text-center text-xs text-slate-500">
                Lunas: <%= formatRupiah(summary.totalRevenue) %> | Belum: <%= formatRupiah(summary.totalUnpaid) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% } %>

  </div>

</div>

<%- include('../partials/footer') %>
