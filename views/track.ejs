<%- include('partials/header', { title: 'Lacak Status Cucian' }) %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">

  <!-- Header Banner / Search Box -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider mb-3">
      <i class="fa-solid fa-satellite-dish animate-pulse text-blue-600"></i> Live Tracking <%= outlet.name %>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Lacak Status Cucian Anda</h1>
    <p class="text-slate-600 mt-2 text-xs sm:text-sm max-w-lg mx-auto">
      Masukkan nomor nota / invoice Anda untuk melihat proses cuci, setrika, atau kesiapan pengambilan.
    </p>

    <!-- Search Form -->
    <form action="/track" method="GET" class="mt-6 max-w-xl mx-auto">
      <div class="relative flex items-center shadow-lg shadow-blue-900/5 rounded-2xl overflow-hidden border border-slate-200 focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-100 bg-white transition-all">
        <div class="pl-4 text-slate-400">
          <i class="fa-solid fa-receipt text-lg"></i>
        </div>
        <input 
          type="text" 
          name="invoice" 
          value="<%= searchQuery || '' %>" 
          placeholder="Contoh: KLND09140126052201" 
          required
          class="w-full px-4 py-4 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none font-mono tracking-wider font-semibold uppercase"
        >
        <button 
          type="submit" 
          class="bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold px-6 py-4 transition-all flex items-center gap-2 text-xs sm:text-sm shrink-0"
        >
          <span>Lacak</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
      </div>
    </form>
  </div>

  <!-- Error Alert -->
  <% if (errorMessage) { %>
    <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 flex items-start gap-3 shadow-sm animate-shake">
      <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 mt-0.5">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div>
        <h4 class="font-bold text-sm sm:text-base">Nota Tidak Ditemukan</h4>
        <p class="text-xs sm:text-sm text-rose-700 mt-1"><%= errorMessage %></p>
      </div>
    </div>
  <% } %>

  <!-- Order Receipt Card -->
  <% if (order) { %>
    <div id="receipt-card" class="bg-white rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/50 overflow-hidden transition-all">
      
      <!-- Card Header / Status Banner -->
      <div class="p-6 sm:p-8 
        <% if (order.laundry_status === 'Sedang Diproses') { %>
          bg-gradient-to-br from-amber-500 via-amber-600 to-amber-700 text-white
        <% } else if (order.laundry_status === 'Siap Diambil' || order.laundry_status === 'Siap Diantar') { %>
          bg-gradient-to-br from-emerald-500 via-emerald-600 to-teal-700 text-white
        <% } else if (order.laundry_status === 'Selesai') { %>
          bg-gradient-to-br from-slate-600 via-slate-700 to-slate-800 text-white
        <% } %>
      ">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-2xl shadow-inner">
              <% if (order.laundry_status === 'Sedang Diproses') { %>
                <i class="fa-solid fa-spinner fa-spin"></i>
              <% } else if (order.laundry_status === 'Siap Diambil') { %>
                <i class="fa-solid fa-bag-shopping"></i>
              <% } else if (order.laundry_status === 'Siap Diantar') { %>
                <i class="fa-solid fa-truck-fast"></i>
              <% } else { %>
                <i class="fa-solid fa-circle-check"></i>
              <% } %>
            </div>
            <div>
              <p class="text-xs font-semibold tracking-wider uppercase opacity-80">Status Cucian Anda</p>
              <h2 class="text-2xl sm:text-3xl font-black tracking-tight"><%= order.laundry_status %></h2>
            </div>
          </div>

          <!-- Payment Pill Badge -->
          <div class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-sm
            <%= order.payment_status === 'Lunas' ? 'bg-white text-emerald-700' : 'bg-rose-500 text-white animate-pulse' %>">
            <i class="fa-solid <%= order.payment_status === 'Lunas' ? 'fa-circle-check' : 'fa-clock' %>"></i>
            <span><%= order.payment_status %></span>
          </div>
        </div>

        <!-- Visual Step Tracker -->
        <div class="mt-6 pt-6 border-t border-white/20">
          <div class="grid grid-cols-3 gap-2 text-center text-xs">
            
            <div class="flex flex-col items-center">
              <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold mb-1 shadow-md
                <%= order.laundry_status === 'Sedang Diproses' ? 'bg-white text-amber-700 ring-4 ring-white/30' : 'bg-white/30 text-white' %>">
                1
              </div>
              <span class="font-semibold <%= order.laundry_status === 'Sedang Diproses' ? 'opacity-100 font-bold' : 'opacity-80' %>">Dicuci / Diproses</span>
            </div>

            <div class="flex flex-col items-center">
              <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold mb-1 shadow-md
                <%= (order.laundry_status === 'Siap Diambil' || order.laundry_status === 'Siap Diantar') ? 'bg-white text-emerald-700 ring-4 ring-white/30' : (order.laundry_status === 'Selesai' ? 'bg-emerald-400 text-slate-900' : 'bg-white/20 text-white/60') %>">
                2
              </div>
              <span class="font-semibold <%= (order.laundry_status === 'Siap Diambil' || order.laundry_status === 'Siap Diantar') ? 'opacity-100 font-bold' : 'opacity-80' %>">
                <%= order.pickup_method === 'Diantar Kurir' ? 'Siap Diantar' : 'Siap Diambil' %>
              </span>
            </div>

            <div class="flex flex-col items-center">
              <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold mb-1 shadow-md
                <%= order.laundry_status === 'Selesai' ? 'bg-white text-slate-800 ring-4 ring-white/30' : 'bg-white/20 text-white/60' %>">
                3
              </div>
              <span class="font-semibold <%= order.laundry_status === 'Selesai' ? 'opacity-100 font-bold' : 'opacity-80' %>">Selesai / Diambil</span>
            </div>

          </div>
        </div>

        <!-- Estimated Finish Banner -->
        <% if (order.laundry_status === 'Sedang Diproses' && order.estimated_finish_at) { %>
          <div class="mt-5 p-3 rounded-xl bg-black/20 backdrop-blur-sm flex items-center gap-2.5 text-xs sm:text-sm">
            <i class="fa-regular fa-clock text-amber-200"></i>
            <span>Estimasi Siap Ambil: <strong><%= formatDateIndo(order.estimated_finish_at) %></strong></span>
          </div>
        <% } %>
      </div>

      <!-- Receipt Body -->
      <div class="p-6 sm:p-8 space-y-6">
        
        <!-- Invoice & Date Info -->
        <div class="flex flex-wrap items-center justify-between pb-6 border-b border-slate-100 gap-3">
          <div>
            <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Nomor Nota / Invoice</span>
            <div class="flex items-center gap-2 mt-0.5">
              <h3 class="text-lg sm:text-xl font-mono font-bold text-slate-900"><%= order.invoice_code %></h3>
              <button onclick="copyToClipboard('<%= order.invoice_code %>', 'Nomor invoice disalin!')" class="text-slate-400 hover:text-blue-600 p-1 transition-colors" title="Salin Invoice">
                <i class="fa-regular fa-copy"></i>
              </button>
            </div>
          </div>
          <div class="text-left sm:text-right">
            <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Waktu Masuk Cucian</span>
            <p class="text-sm font-medium text-slate-700 mt-0.5"><%= formatDateIndo(order.created_at) %></p>
          </div>
        </div>

        <!-- Customer & Delivery Info Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-6 border-b border-slate-100">
          <!-- Customer Details -->
          <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-100">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2 mb-3">
              <i class="fa-solid fa-user text-blue-600"></i> Pelanggan
            </h4>
            <div class="space-y-1.5 text-sm">
              <p class="font-bold text-slate-900 text-base"><%= order.customer_name %></p>
              <p class="text-slate-600 flex items-center gap-2 text-xs">
                <i class="fa-solid fa-phone text-xs text-slate-400"></i> <%= order.customer_phone %>
              </p>
              <p class="text-slate-600 text-xs flex items-start gap-2 pt-1">
                <i class="fa-solid fa-location-dot text-xs text-slate-400 mt-0.5"></i> <%= order.customer_address || 'Karangsentul / Sekitar Padamara' %>
              </p>
            </div>
          </div>

          <!-- Pickup / Delivery Details -->
          <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-100">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2 mb-3">
              <i class="fa-solid fa-truck-ramp-box text-blue-600"></i> Pengambilan & Outlet
            </h4>
            <div class="space-y-2 text-sm">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-bold
                <%= order.pickup_method === 'Diantar Kurir' ? 'bg-indigo-100 text-indigo-800' : 'bg-amber-100 text-amber-800' %>">
                <i class="fa-solid <%= order.pickup_method === 'Diantar Kurir' ? 'fa-motorcycle' : 'fa-store' %>"></i>
                <span><%= order.pickup_method %></span>
              </div>
              <p class="text-xs text-slate-500 leading-relaxed">
                <% if (order.pickup_method === 'Diantar Kurir') { %>
                  Cucian akan diantar ke alamat Anda setelah status menjadi <strong>Siap Diantar</strong>.
                <% } else { %>
                  Silakan ambil cucian di outlet <strong><%= outlet.name %></strong> (<%= outlet.address %>).
                <% } %>
              </p>
              <% if (order.notes) { %>
                <div class="pt-2 border-t border-slate-200/60 text-xs text-slate-600">
                  <span class="font-semibold text-slate-700">Catatan:</span> <%= order.notes %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Laundry Breakdown Table -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Rincian Paket & Biaya</h4>
          
          <div class="bg-slate-50 rounded-2xl p-4 sm:p-5 border border-slate-100">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <div>
                <span class="font-bold text-slate-800 text-sm sm:text-base"><%= order.service_name %></span>
                <p class="text-xs text-slate-500"><%= formatRupiah(order.price_per_unit) %> / <%= order.unit_type || 'kg' %></p>
              </div>
              <div class="text-right">
                <span class="font-bold text-slate-800 text-sm sm:text-base"><%= order.weight %> kg</span>
                <% if (order.piece_count > 0) { %>
                  <p class="text-xs text-slate-500 font-semibold">(<%= order.piece_count %> potong baju)</p>
                <% } %>
              </div>
            </div>

            <div class="flex items-center justify-between pt-3 text-base sm:text-lg">
              <div>
                <span class="font-bold text-slate-700">Total Tagihan</span>
                <p class="text-[11px] text-slate-400">
                  <%= order.payment_status === 'Lunas' ? '✅ Sudah Lunas' : '⏳ Pembayaran bisa saat mengambil cucian / transfer' %>
                </p>
              </div>
              <span class="font-extrabold text-blue-700 text-xl"><%= formatRupiah(order.total_price) %></span>
            </div>
          </div>
        </div>

        <!-- Bank Transfer Payment Info Box -->
        <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200/80 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-blue-900 font-bold text-sm sm:text-base">
              <i class="fa-solid fa-building-columns text-blue-600"></i>
              <span>Transfer Bank (Bagi yang Belum Lunas)</span>
            </div>
            <span class="text-xs font-semibold text-blue-700 bg-blue-100 px-2.5 py-0.5 rounded-full">BSI</span>
          </div>

          <div class="bg-white p-4 rounded-xl border border-blue-200 shadow-sm flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs text-slate-400 font-medium"><%= bankInfo.bankName %></p>
              <p class="text-lg sm:text-xl font-mono font-extrabold text-slate-900 tracking-wider"><%= bankInfo.accountNumber %></p>
              <p class="text-xs font-semibold text-slate-700 mt-0.5">a.n <%= bankInfo.accountHolder %></p>
            </div>
            <button 
              onclick="copyToClipboard('<%= bankInfo.accountNumber %>', 'Nomor rekening berhasil disalin!')" 
              class="px-4 py-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white rounded-lg text-xs font-bold transition-all flex items-center gap-2 shadow-sm"
            >
              <i class="fa-regular fa-copy"></i>
              <span>Salin Rekening</span>
            </button>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-4">
          <button onclick="window.print()" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs sm:text-sm font-semibold transition-colors flex items-center gap-2">
            <i class="fa-solid fa-print"></i> Cetak Bukti Nota
          </button>

          <% 
            const waPhone = outlet.phoneRaw;
            const waMessage = encodeURIComponent(`Halo Kak Admin ${outlet.name}, saya ingin tanya pesanan nota ${order.invoice_code} atas nama ${order.customer_name}. Total: ${formatRupiah(order.total_price)}. Link: ${hostUrl}/track/${order.invoice_code}`);
          %>
          <a 
            href="https://wa.me/<%= waPhone %>?text=<%= waMessage %>" 
            target="_blank" 
            class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 shadow-sm shadow-emerald-600/20"
          >
            <i class="fa-brands fa-whatsapp text-base"></i> Hubungi CS <%= outlet.name %>
          </a>
        </div>

      </div>

    </div>
  <% } %>

</div>

<%- include('partials/footer') %>
