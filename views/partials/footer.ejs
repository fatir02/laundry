  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 mt-12 py-8 text-slate-500 text-xs sm:text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      
      <!-- Outlet Identity Info Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pb-4 border-b border-slate-100">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <div class="w-6 h-6 rounded bg-blue-600 text-white flex items-center justify-center text-xs">
              <i class="fa-solid fa-soap"></i>
            </div>
            <span class="font-extrabold text-slate-800 text-base"><%= outlet.name %></span>
          </div>
          <p class="text-xs text-slate-400"><%= outlet.tagline %></p>
        </div>

        <div>
          <p class="font-bold text-slate-700 text-xs mb-1 flex items-center gap-1.5">
            <i class="fa-solid fa-location-dot text-blue-600"></i> Alamat Outlet:
          </p>
          <p class="text-xs text-slate-500 leading-relaxed"><%= outlet.address %></p>
        </div>

        <div>
          <p class="font-bold text-slate-700 text-xs mb-1 flex items-center gap-1.5">
            <i class="fa-solid fa-clock text-blue-600"></i> Jam Operasional:
          </p>
          <p class="text-xs text-slate-500"><%= outlet.hours %></p>
          <p class="text-xs text-slate-500 mt-1">
            <i class="fa-brands fa-whatsapp text-emerald-600 font-bold"></i> WA: <strong><%= outlet.phone %></strong>
          </p>
        </div>
      </div>

      <!-- Bottom Bar & Discreet Admin Portal -->
      <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400">
        <span>&copy; <%= new Date().getFullYear() %> <%= outlet.name %>. All Rights Reserved.</span>
        
        <div>
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Admin Login Aktif
            </span>
          <% } else { %>
            <a href="/admin/login" class="text-slate-400 hover:text-slate-600 transition-colors flex items-center gap-1">
              <i class="fa-solid fa-lock text-[10px]"></i> Portal Admin
            </a>
          <% } %>
        </div>
      </div>

    </div>
  </footer>

  <!-- Toast Notification Container -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-3 text-sm">
    <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
    <span id="toast-msg">Notifikasi</span>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
